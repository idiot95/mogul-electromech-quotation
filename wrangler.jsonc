// Mogul Workspace · Cloudflare Worker config
// Two deployed environments: staging and production (live). Each has its own D1 database and R2 bucket,
// both in Western Europe (Amsterdam), the closest region to the UAE.
// IDs marked REPLACE_ are filled in by scripts/cf-provision.mjs (run by the deploy workflow) — it creates the D1 database
// and R2 bucket on first deploy and writes the database id here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mogul-workspace",
  "account_id": "8b5a0805bbba173253e514e0586566b4",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Run the Worker next to its database (D1 is in Western Europe) instead of next to the visitor.
  "placement": { "mode": "smart" },

  // ---- local dev (wrangler dev) ----
  "vars": { "APP_ENV": "local" },
  "d1_databases": [
    { "binding": "DB", "database_name": "mogul-workspace-local", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "mogul-workspace-local" }],

  "env": {
    "staging": {
      "name": "mogul-workspace-staging",
      "vars": { "APP_ENV": "staging" },
      // Custom domain: Cloudflare creates the DNS record and certificate on deploy (mogulelectromech.com DNS is on Cloudflare).
      "routes": [{ "pattern": "quotes-staging.mogulelectromech.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "mogul-workspace-staging-eu", "database_id": "0aa518c6-7ca3-45dd-bcc9-b72ec7185774", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "mogul-workspace-staging-eu" }]
    },
    "production": {
      "name": "mogul-workspace",
      "vars": { "APP_ENV": "production" },
      "routes": [{ "pattern": "quotes.mogulelectromech.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "mogul-workspace-production", "database_id": "REPLACE_PRODUCTION_D1_ID", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "mogul-workspace-production" }]
    }
  }
}
